{
  "mcpServers": {
    "azure-operator": {
      "command": "python",
      "args": [
        "-m",
        "mcp_server"
      ],
      "cwd": "${workspaceFolder}/mcp/azure-operator",
      "env": {
        "AZURE_SUBSCRIPTION_ID": "${env:AZURE_SUBSCRIPTION_ID}",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
