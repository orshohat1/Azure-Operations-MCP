# Azure Authentication - Service Principal (optional)
# If set, these will be used for authentication
# If not set, DefaultAzureCredential will use az login or Managed Identity
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Default Azure Subscription (optional)
AZURE_SUBSCRIPTION_ID=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Rate Limiting
MAX_ACTIONS_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO

# Test Mode (DO NOT USE IN PRODUCTION)
# Set to "true" to disable authentication for testing purposes only
TEST_MODE=false
